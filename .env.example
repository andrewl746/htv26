# Copy to .env (never committed). Every variable the project reads.
SUPLEX_DATA_DIR=./data/out          # processed files from the team drive (suplex.gpkg, ward_summary.json, ...)
SUPLEX_GPKG=                        # optional: the API loads this GeoPackage instead of $SUPLEX_DATA_DIR/suplex.gpkg (e.g. the citywide file)
SUPLEX_CORS_ORIGINS=                # optional: extra origins the API allows, comma-separated (localhost ports are always allowed)
SUPLEX_DEMO_CACHE=0                # 1 = the API serves api/cache/* whenever a cached response exists
SUPLEX_API_URL=http://localhost:8000 # the AI service reads ward data from here
TIGER_DSN=                          # Tiger Data connection string; unset = trend cache fallback
GEMINI_API_KEY=                     # Simone's AI service
GEMINI_MODEL=gemini-3.5-flash-lite  # everyday model (500 requests/day); gemini-3.8-flash only for the one-off demo pre-generation after Hour 24
SUPLEX_AI_URL=http://localhost:8001 # the AI service's own address: the briefing page's methodology links and the API's briefing_url
AI_LOG_DIR=ai/logs                  # validator rejection log (optional)
