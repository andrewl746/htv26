{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BriefingRequest",
  "description": "POST /briefing request body (AI service). Mirrors `BriefingRequest` in contracts/types.ts; change the schema, types.ts and the fixtures together.",
  "type": "object",
  "properties": {
    "ward": {
      "description": "A WardSummaryEntry; the briefing page posts the GET /ward/{id} response, so a WardResponse (the entry plus its four urls) is accepted too",
      "anyOf": [{"$ref": "#/$defs/WardSummaryEntry"}, {"$ref": "#/$defs/WardResponse"}]
    },
    "trend": {"anyOf": [{"$ref": "#/$defs/TrendResponse"}, {"type": "null"}]},
    "lang": {"$ref": "#/$defs/Lang"}
  },
  "required": ["ward", "trend", "lang"],
  "additionalProperties": false,
  "$defs": {
    "RuleId": {
      "type": "string",
      "enum": [
        "detached_building", "units_allowed", "lot_width", "lot_depth", "building_length", "height",
        "lot_coverage"
      ]
    },
    "WardId": {
      "type": "string",
      "description": "Two-digit zero-padded ward id, \"01\" to \"25\" (City Wards AREA_SHORT_CODE).",
      "pattern": "^(0[1-9]|1[0-9]|2[0-5])$"
    },
    "Lang": {"type": "string", "enum": ["en", "fr", "zh-Hans", "zh-Hant", "es", "tl", "ta", "pt"]},
    "Date": {
      "type": "string",
      "description": "YYYY-MM-DD",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "Month": {"type": "string", "description": "YYYY-MM", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "DateTime": {
      "type": "string",
      "description": "ISO 8601 date-time with a timezone",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "DataDates": {
      "type": "object",
      "description": "Dataset name -> last refreshed date (Record<string, string>).",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/Date"}
    },
    "ResultCounts": {
      "type": "object",
      "properties": {
        "fits": {"type": "integer", "minimum": 0},
        "borderline": {"type": "integer", "minimum": 0},
        "no_fit": {"type": "integer", "minimum": 0},
        "not_checked": {"type": "integer", "minimum": 0}
      },
      "required": ["fits", "borderline", "no_fit", "not_checked"],
      "additionalProperties": false
    },
    "ClassCounts": {
      "type": "object",
      "description": "Record<LotClass, number>: all seven classes required",
      "properties": {
        "condo": {"type": "integer", "minimum": 0},
        "non_residential": {"type": "integer", "minimum": 0},
        "older_bylaw": {"type": "integer", "minimum": 0},
        "larger_building": {"type": "integer", "minimum": 0},
        "unmeasurable": {"type": "integer", "minimum": 0},
        "attached": {"type": "integer", "minimum": 0},
        "checked": {"type": "integer", "minimum": 0}
      },
      "required": [
        "condo", "non_residential", "older_bylaw", "larger_building", "unmeasurable", "attached", "checked"
      ],
      "additionalProperties": false
    },
    "DesignCounts": {
      "type": "object",
      "description": "Record<DesignId, ResultCounts>: all four designs required",
      "properties": {
        "fourplex_narrow": {"$ref": "#/$defs/ResultCounts"},
        "fourplex_wide": {"$ref": "#/$defs/ResultCounts"},
        "sixplex_narrow": {"$ref": "#/$defs/ResultCounts"},
        "sixplex_wide": {"$ref": "#/$defs/ResultCounts"}
      },
      "required": ["fourplex_narrow", "fourplex_wide", "sixplex_narrow", "sixplex_wide"],
      "additionalProperties": false
    },
    "KindCounts": {
      "type": "object",
      "description": "Record<PermitKind, number>: all four kinds required",
      "properties": {
        "multiplex": {"type": "integer", "minimum": 0},
        "secondary_suite": {"type": "integer", "minimum": 0},
        "laneway_garden": {"type": "integer", "minimum": 0},
        "other": {"type": "integer", "minimum": 0}
      },
      "required": ["multiplex", "secondary_suite", "laneway_garden", "other"],
      "additionalProperties": false
    },
    "WardSummaryEntry": {
      "type": "object",
      "properties": {
        "ward_id": {
          "type": "string",
          "description": "WardId, or \"city\" for the city-wide entry of ward_summary.json",
          "pattern": "^(0[1-9]|1[0-9]|2[0-5]|city)$"
        },
        "ward_name": {"type": "string", "minLength": 1},
        "sixplex_overlay": {"type": "string", "enum": ["full", "partial", "none"]},
        "lots_total": {"type": "integer", "minimum": 0},
        "house_lots": {"type": "integer", "minimum": 0},
        "classes": {"$ref": "#/$defs/ClassCounts"},
        "any_design": {"$ref": "#/$defs/ResultCounts"},
        "by_design": {"$ref": "#/$defs/DesignCounts"},
        "top_blocking_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"rule_id": {"$ref": "#/$defs/RuleId"}, "count": {"type": "integer", "minimum": 0}},
            "required": ["rule_id", "count"],
            "additionalProperties": false
          }
        },
        "attached_share_pct": {"type": "number", "minimum": 0},
        "flags": {
          "type": "object",
          "properties": {
            "heritage_register": {"type": "integer", "minimum": 0},
            "heritage_district": {"type": "integer", "minimum": 0},
            "ravine": {"type": "integer", "minimum": 0},
            "trca": {"type": "integer", "minimum": 0},
            "site_exception": {"type": "integer", "minimum": 0},
            "vacant": {"type": "integer", "minimum": 0},
            "any_on_fitting_lots": {"type": "integer", "minimum": 0}
          },
          "required": [
            "heritage_register", "heritage_district", "ravine", "trca", "site_exception", "vacant",
            "any_on_fitting_lots"
          ],
          "additionalProperties": false
        },
        "permits": {
          "type": "object",
          "properties": {
            "rule": {"type": "string", "minLength": 1},
            "since_may_2023": {"type": "integer", "minimum": 0},
            "by_kind_since_may_2023": {"$ref": "#/$defs/KindCounts"},
            "by_year": {
              "type": "object",
              "description": "Record<string, number>: year -> count",
              "propertyNames": {"pattern": "^[0-9]{4}$"},
              "additionalProperties": {"type": "integer", "minimum": 0}
            },
            "units_since_may_2023": {"type": "integer", "minimum": 0},
            "source": {"type": "string", "enum": ["tigerdata", "local"]}
          },
          "required": [
            "rule", "since_may_2023", "by_kind_since_may_2023", "by_year", "units_since_may_2023", "source"
          ],
          "additionalProperties": false
        },
        "headline": {
          "type": "object",
          "properties": {
            "could": {"type": "integer", "minimum": 0},
            "could_pct_of_house_lots": {"type": "number", "minimum": 0},
            "did": {"type": "integer", "minimum": 0},
            "lots_per_permit": {"type": ["number", "null"], "minimum": 0}
          },
          "required": ["could", "could_pct_of_house_lots", "did", "lots_per_permit"],
          "additionalProperties": false
        },
        "data_dates": {"$ref": "#/$defs/DataDates"},
        "generated_at": {"$ref": "#/$defs/DateTime"}
      },
      "required": [
        "ward_id", "ward_name", "sixplex_overlay", "lots_total", "house_lots", "classes", "any_design",
        "by_design", "top_blocking_rules", "attached_share_pct", "flags", "permits", "headline", "data_dates",
        "generated_at"
      ],
      "additionalProperties": false
    },
    "WardResponse": {
      "type": "object",
      "description": "WardSummaryEntry plus the four urls",
      "properties": {
        "ward_id": {"$ref": "#/$defs/WardId"},
        "ward_name": {"type": "string", "minLength": 1},
        "sixplex_overlay": {"type": "string", "enum": ["full", "partial", "none"]},
        "lots_total": {"type": "integer", "minimum": 0},
        "house_lots": {"type": "integer", "minimum": 0},
        "classes": {"$ref": "#/$defs/ClassCounts"},
        "any_design": {"$ref": "#/$defs/ResultCounts"},
        "by_design": {"$ref": "#/$defs/DesignCounts"},
        "top_blocking_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"rule_id": {"$ref": "#/$defs/RuleId"}, "count": {"type": "integer", "minimum": 0}},
            "required": ["rule_id", "count"],
            "additionalProperties": false
          }
        },
        "attached_share_pct": {"type": "number", "minimum": 0},
        "flags": {
          "type": "object",
          "properties": {
            "heritage_register": {"type": "integer", "minimum": 0},
            "heritage_district": {"type": "integer", "minimum": 0},
            "ravine": {"type": "integer", "minimum": 0},
            "trca": {"type": "integer", "minimum": 0},
            "site_exception": {"type": "integer", "minimum": 0},
            "vacant": {"type": "integer", "minimum": 0},
            "any_on_fitting_lots": {"type": "integer", "minimum": 0}
          },
          "required": [
            "heritage_register", "heritage_district", "ravine", "trca", "site_exception", "vacant",
            "any_on_fitting_lots"
          ],
          "additionalProperties": false
        },
        "permits": {
          "type": "object",
          "properties": {
            "rule": {"type": "string", "minLength": 1},
            "since_may_2023": {"type": "integer", "minimum": 0},
            "by_kind_since_may_2023": {"$ref": "#/$defs/KindCounts"},
            "by_year": {
              "type": "object",
              "description": "Record<string, number>: year -> count",
              "propertyNames": {"pattern": "^[0-9]{4}$"},
              "additionalProperties": {"type": "integer", "minimum": 0}
            },
            "units_since_may_2023": {"type": "integer", "minimum": 0},
            "source": {"type": "string", "enum": ["tigerdata", "local"]}
          },
          "required": [
            "rule", "since_may_2023", "by_kind_since_may_2023", "by_year", "units_since_may_2023", "source"
          ],
          "additionalProperties": false
        },
        "headline": {
          "type": "object",
          "properties": {
            "could": {"type": "integer", "minimum": 0},
            "could_pct_of_house_lots": {"type": "number", "minimum": 0},
            "did": {"type": "integer", "minimum": 0},
            "lots_per_permit": {"type": ["number", "null"], "minimum": 0}
          },
          "required": ["could", "could_pct_of_house_lots", "did", "lots_per_permit"],
          "additionalProperties": false
        },
        "data_dates": {"$ref": "#/$defs/DataDates"},
        "generated_at": {"$ref": "#/$defs/DateTime"},
        "lots_url": {"type": "string", "minLength": 1},
        "permits_url": {"type": "string", "minLength": 1},
        "trend_url": {"type": "string", "minLength": 1},
        "briefing_url": {"type": "string", "minLength": 1}
      },
      "required": [
        "ward_id", "ward_name", "sixplex_overlay", "lots_total", "house_lots", "classes", "any_design",
        "by_design", "top_blocking_rules", "attached_share_pct", "flags", "permits", "headline", "data_dates",
        "generated_at", "lots_url", "permits_url", "trend_url", "briefing_url"
      ],
      "additionalProperties": false
    },
    "TrendPoint": {
      "type": "object",
      "properties": {
        "month": {"$ref": "#/$defs/Month"},
        "permits": {"type": "integer", "minimum": 0},
        "units": {"type": "integer", "minimum": 0}
      },
      "required": ["month", "permits", "units"],
      "additionalProperties": false
    },
    "TrendMarker": {
      "type": "object",
      "properties": {"month": {"$ref": "#/$defs/Month"}, "label": {"type": "string", "minLength": 1}},
      "required": ["month", "label"],
      "additionalProperties": false
    },
    "TrendResponse": {
      "type": "object",
      "properties": {
        "ward_id": {"$ref": "#/$defs/WardId"},
        "source": {"type": "string", "enum": ["tigerdata", "cache", "local"]},
        "since": {"$ref": "#/$defs/Month"},
        "series": {"type": "array", "items": {"$ref": "#/$defs/TrendPoint"}},
        "markers": {"type": "array", "items": {"$ref": "#/$defs/TrendMarker"}},
        "generated_at": {"$ref": "#/$defs/DateTime"}
      },
      "required": ["ward_id", "source", "since", "series", "markers", "generated_at"],
      "additionalProperties": false
    }
  }
}
