{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PermitFeatureProps",
  "description": "properties of each feature in permits.geojson. Mirrors `PermitFeatureProps` in contracts/types.ts; change the schema, types.ts and the fixtures together.",
  "type": "object",
  "properties": {
    "id": {"type": "integer"},
    "d": {"$ref": "#/$defs/Date"},
    "w": {"$ref": "#/$defs/WardId"},
    "u": {"type": "integer", "minimum": 0},
    "k": {"$ref": "#/$defs/PermitKind"}
  },
  "required": ["id", "d", "w", "u", "k"],
  "additionalProperties": false,
  "$defs": {
    "PermitKind": {"type": "string", "enum": ["multiplex", "secondary_suite", "laneway_garden", "other"]},
    "WardId": {
      "type": "string",
      "description": "Two-digit zero-padded ward id, \"01\" to \"25\" (City Wards AREA_SHORT_CODE).",
      "pattern": "^(0[1-9]|1[0-9]|2[0-5])$"
    },
    "Date": {
      "type": "string",
      "description": "YYYY-MM-DD",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    }
  }
}
